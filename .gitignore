# Data — không commit (dataset gốc + merged đều lớn, tải/dựng lại được từ script)
data/raw/
data/raw_*/
data/merged/
data/merged_*/
data/vn_only/
data/test_videos/raw/
data/test_videos/frames/
data/*.zip
data/*.jpg
data/*.png

# Weights lớn — repo chỉ giữ README + script dựng, không giữ .pt
weights/*.pt
weights/*.onnx
weights/pretrained/
weights/trained/
!weights/.gitkeep
!weights/README.md
# Ultralytics tự download về pwd
/yolo*.pt
/yolo*.onnx
scripts/training/*.pt

# Training outputs (nếu muốn commit chart quan trọng, dùng `git add -f`)
runs/
logs/*.log
results/videos/*.mp4
results/videos/*.avi
baseline/*.mp4
baseline/*.avi

# Word/Office lock files
~$*
*.tmp
# CSV events lớn, tạm thời
results/tables/streamlit_*.csv
results/tables/compare_*.csv
results/tables/smoke_*.csv
results/tables/cmp_*.csv

# Prediction cache lớn (reproducible từ eval scripts)
results/error_analysis/*.pkl
results/final_report/videos/*.mp4
results/final_report/videos/*.avi

# Zip đã có folder đầy đủ commit rồi
docs/comparison_report.zip
slides_assets.zip

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp
